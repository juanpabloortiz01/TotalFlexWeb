# ──────────────────────────────────────────────────────────────
# TotalFlexGym — Variables de Entorno
# Copia este archivo como `.env.local` y rellena los valores
# ⚠️  NUNCA commiteés .env.local al repositorio
# ──────────────────────────────────────────────────────────────

# ── BASE DE DATOS (PostgreSQL en Easypanel) ─────────────────
DATABASE_URL=postgresql://totalflex_user:your_password@localhost:5432/totalflexgym

# ── URL PÚBLICA DEL SITIO ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://totalflexgym.com.ec

# ── PAYPHONE (Pasarela Ecuador) ─────────────────────────────
# Obtener en: https://payphone.app/developers
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_APP_ID=

# ── STRIPE (Alternativa internacional) ─────────────────────
# Solo si se elige Stripe en lugar de PayPhone
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── WHATSAPP / NOTIFICACIONES ───────────────────────────────
# Para envío de confirmaciones automáticas
# Proveedor recomendado: Wassenger o Twilio
WHATSAPP_API_URL=https://api.wassenger.com/v1
WHATSAPP_API_KEY=

# Número del gimnasio (con código de país, sin +)
WHATSAPP_GYM_NUMBER=593XXXXXXXXX

# ── RESEND (Email transaccional) ────────────────────────────
# Alternativa: SendGrid, Mailgun
RESEND_API_KEY=re_...
EMAIL_FROM=no-reply@totalflexgym.com.ec

# ── NEXTAUTH (Si se agrega panel admin con login) ───────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://totalflexgym.com.ec
